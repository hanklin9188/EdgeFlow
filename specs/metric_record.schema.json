{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgeflow.dev/schemas/metric_record.schema.json",
  "title": "EdgeFlow MetricRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "request_id",
    "source_type",
    "phase",
    "iteration",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_type": {
      "enum": [
        "measured",
        "demo",
        "estimated"
      ]
    },
    "phase": {
      "enum": [
        "load",
        "compile",
        "autotune",
        "capture",
        "warmup",
        "prefill",
        "decode",
        "end_to_end",
        "profile"
      ]
    },
    "iteration": {
      "type": "integer",
      "minimum": 0
    },
    "prompt_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wall_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "ttft_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "tpot_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "request_latency_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "prompt_tokens_per_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "generation_tokens_per_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "requests_per_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "queue_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "peak_vram_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "gpu_energy_j": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "temperature_c": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "sm_clock_mhz": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "memory_clock_mhz": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "token_timestamps_ms": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "fallbacks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
