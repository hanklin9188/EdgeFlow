{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgeflow.dev/schemas/validation_verdict.schema.json",
  "title": "EdgeFlow ValidationVerdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "verdict", "policy_eligible",
    "public_claim_eligible", "quality_pass", "evidence_level", "checks", "issues", "scope"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string"},
    "verdict": {"enum": ["PASS", "CONDITIONAL_PASS", "FAIL", "INVALID", "SKIPPED"]},
    "policy_eligible": {"type": "boolean"},
    "public_claim_eligible": {"type": "boolean"},
    "quality_pass": {"type": ["boolean", "null"]},
    "evidence_level": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5"]},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gate", "name", "status", "message"],
        "properties": {
          "gate": {"type": "string"},
          "name": {"type": "string"},
          "status": {"enum": ["PASS", "FAIL", "WARN", "SKIP"]},
          "message": {"type": "string"},
          "artifact": {"type": ["string", "null"]}
        }
      }
    },
    "issues": {"type": "array", "items": {"type": "object"}},
    "scope": {"type": "object"},
    "validated_at": {"type": ["string", "null"], "format": "date-time"},
    "validator_version": {"type": ["string", "null"]}
  }
}
